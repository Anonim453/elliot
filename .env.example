# Elliot Voice Assistant - Конфигурация
# Скопируйте этот файл как .env и заполните значения

# Google Gemini API Key (бесплатно: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (бесплатные: gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Whisper модель (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Язык распознавания
WHISPER_LANGUAGE=ru

# TTS голос (ru-RU-DmitryNeural, ru-RU-SvetlanaNeural)
TTS_VOICE=ru-RU-DmitryNeural

# Горячая клавиша активации (по умолчанию Ctrl+Space)
HOTKEY=ctrl+space
