/* ============================================================
   Elliot — Dark Theme (Fluent / Material Dark)
   Палитра:
     Фон:      #0f0f23, #1a1a2e, #16213e
     Панели:    #1e1e3f, #252547
     Акцент 1: #00d4ff (голубой неон)
     Акцент 2: #7c3aed (фиолетовый)
     Текст:    #e2e8f0, #94a3b8
     Ошибка:   #ef4444
     Успех:    #22c55e
   ============================================================ */

/* --- Глобальные стили --- */
* {
    font-family: "Segoe UI", "Segoe UI Variable", sans-serif;
    font-size: 13px;
    color: #e2e8f0;
    outline: none;
}

QWidget {
    background-color: transparent;
}

QMainWindow {
    background-color: #0f0f23;
    border: 1px solid #2a2a4a;
    border-radius: 12px;
}

/* --- Title Bar --- */
QWidget#titleBar {
    background-color: #0f0f23;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-height: 40px;
    max-height: 40px;
}

QLabel#titleLabel {
    font-size: 15px;
    font-weight: bold;
    color: #00d4ff;
    padding-left: 8px;
}

QPushButton#btnMinimize,
QPushButton#btnClose {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 14px;
    color: #94a3b8;
}

QPushButton#btnMinimize:hover {
    background-color: #252547;
    color: #e2e8f0;
}

QPushButton#btnClose:hover {
    background-color: #ef4444;
    color: #ffffff;
}

/* --- Chat View --- */
QScrollArea#chatView {
    background-color: #0f0f23;
    border: none;
}

QWidget#chatContainer {
    background-color: transparent;
}

/* Пузыри сообщений */
QFrame#userBubble {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #7c3aed, stop:1 #3b82f6);
    border-radius: 16px;
    border-bottom-right-radius: 4px;
    padding: 10px 14px;
}

QFrame#assistantBubble {
    background-color: #1e1e3f;
    border: 1px solid #2a2a4a;
    border-radius: 16px;
    border-bottom-left-radius: 4px;
    padding: 10px 14px;
}

QFrame#toolBubble {
    background-color: #16213e;
    border: 1px solid #2a2a4a;
    border-radius: 10px;
    padding: 6px 12px;
}

QLabel#bubbleText {
    font-size: 13px;
    color: #e2e8f0;
    background: transparent;
    padding: 0px;
}

QLabel#toolText {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    color: #94a3b8;
    background: transparent;
}

QLabel#avatarLabel {
    background-color: #7c3aed;
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    border-radius: 15px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    qproperty-alignment: AlignCenter;
}

QLabel#timestampLabel {
    font-size: 10px;
    color: #64748b;
    background: transparent;
}

/* --- Waveform Widget --- */
QWidget#waveformWidget {
    background-color: transparent;
    min-height: 80px;
    max-height: 100px;
}

/* --- Status Indicator --- */
QWidget#statusIndicator {
    background-color: transparent;
}

QLabel#statusText {
    font-size: 11px;
    color: #94a3b8;
    background: transparent;
}

/* --- Нижняя панель --- */
QWidget#bottomPanel {
    background-color: #0f0f23;
    border-top: 1px solid #1e1e3f;
    min-height: 70px;
}

/* Кнопка микрофона */
QPushButton#micButton {
    background-color: #1e1e3f;
    border: 2px solid #2a2a4a;
    border-radius: 28px;
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    font-size: 22px;
    color: #94a3b8;
}

QPushButton#micButton:hover {
    background-color: #252547;
    border-color: #00d4ff;
    color: #00d4ff;
}

QPushButton#micButton[state="listening"] {
    background-color: rgba(0, 212, 255, 0.15);
    border-color: #00d4ff;
    color: #00d4ff;
}

QPushButton#micButton[state="thinking"] {
    background-color: rgba(124, 58, 237, 0.15);
    border-color: #7c3aed;
    color: #7c3aed;
}

QPushButton#micButton[state="speaking"] {
    background-color: rgba(34, 197, 94, 0.15);
    border-color: #22c55e;
    color: #22c55e;
}

/* Текстовое поле ввода */
QLineEdit#textInput {
    background-color: #1e1e3f;
    border: 1px solid #2a2a4a;
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 13px;
    color: #e2e8f0;
    selection-background-color: #7c3aed;
}

QLineEdit#textInput:focus {
    border-color: #00d4ff;
}

QLineEdit#textInput::placeholder {
    color: #64748b;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2a2a4a;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3a3a5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
    border: none;
}

QScrollBar:horizontal {
    height: 0px;
}

/* --- Меню (трей) --- */
QMenu {
    background-color: #1e1e3f;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
    color: #e2e8f0;
}

QMenu::item:selected {
    background-color: #252547;
    color: #00d4ff;
}

QMenu::separator {
    height: 1px;
    background-color: #2a2a4a;
    margin: 4px 8px;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #1e1e3f;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2e8f0;
    font-size: 12px;
}

/* --- Error banner --- */
QLabel#errorBanner {
    background-color: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    border-radius: 8px;
    padding: 8px 12px;
    color: #fca5a5;
    font-size: 12px;
}
